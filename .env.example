# Copiar a .env y ajustar. Rutas relativas = relativas a la carpeta del proyecto.
# Lo que se defina en la línea de comandos tiene prioridad sobre este archivo.

# Excel semanal: un archivo o una carpeta (se toma el .xlsx más reciente)
ENTRADA=./entrada
# Carpeta donde se escriben reportes, avisos, ligas y public/<año>/<semana>/
SALIDA=./salida
# URL donde se sube el contenido de public/ (sin / al final)
BASE_URL=
# Correo para la liga de dirección en ligas-<semana>.csv
DIRECCION_CORREO=
# Clave para firmar los tokens de las ligas (obligatoria, mínimo 32 caracteres). Generar una vez con:
#   python3 -c "import secrets;print(secrets.token_hex(32))"
# Si cambia, cambian todas las ligas; si se filtra, cualquiera puede calcular las ligas de otros.
TOKEN_SECRETO=


FOLDER_SQL=./sql

# Carpeta con las consultas NN-nombre.sql (el número da el orden; el primer comentario, el nombre de la hoja)
FOLDER_SQL=./sql
# Conexión a SQL Server (la usa extraer_excel.py)
SQL_SERVIDOR=
SQL_PUERTO=1433
SQL_BASE_DATOS=
SQL_USUARIO=
SQL_CONTRASENA=
# Segundos máximos por consulta
SQL_TIMEOUT=600
