# Copiar a .env y ajustar. Rutas relativas = relativas a la carpeta del proyecto.
# Lo que se defina en la línea de comandos tiene prioridad sobre este archivo.

# Excel semanal: un archivo o una carpeta (se toma el .xlsx más reciente)
ENTRADA=./entrada
# Carpeta donde se escriben reportes, avisos, ligas y publicar-<semana>/
SALIDA=./salida
# Tokens de las ligas fijas — si se pierde o cambia de ruta, cambian todas las ligas
ESTADO=./estado.json
# Dominio donde se publican los r-<token>.html (sin / al final)
BASE_URL=
# Correo para la liga de dirección en ligas-<semana>.csv
DIRECCION_CORREO=
